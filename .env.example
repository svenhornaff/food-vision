# Copy to .env and fill in. .env is gitignored; this file is the template.

# --- OpenRouter credentials & endpoint --------------------------------------
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_API_URL="https://openrouter.ai/api/v1"

# --- Model allowlist (concept doc §9: "FOOD_VISION_MODELS allowlist;
# default + fallback configured"). Comma-separated OpenRouter model IDs.
# Leave empty during early dev; set before anything production-facing.
FOOD_VISION_MODELS=""
OPENROUTER_DEFAULT_MODEL=""
OPENROUTER_FALLBACK_MODELS=""

# --- Provider routing (concept doc §9) --------------------------------------
# Comma-separated approved provider IDs for production fallback ordering.
OPENROUTER_PROVIDER_ORDER=""
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_DATA_COLLECTION="deny"
OPENROUTER_ZDR=true

# --- Determinism -------------------------------------------------------------
OPENROUTER_TEMPERATURE=0.0
# OPENROUTER_SEED=42

# --- Timeouts / retries ------------------------------------------------------
OPENROUTER_CONNECT_TIMEOUT_S=5.0
OPENROUTER_TOTAL_TIMEOUT_S=30.0
OPENROUTER_MAX_RETRIES=2

# --- Logging ------------------------------------------------------------------
LOG_LEVEL="INFO"
LOG_JSON=false
